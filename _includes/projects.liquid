<div class="project-card">
  {% assign project_url = project.url | relative_url %}
  {% assign thumbnail = project.thumbnail_image | default: project.img %}
  <a
    class="project-card__image{% if project.thumbnail_light %} project-card__image--light{% endif %}"
    href="{{ project_url }}"
    aria-label="View case study: {{ project.title | escape }}"
  >
    {%- include figure.liquid path=thumbnail width=project.thumbnail_width height=project.thumbnail_height alt=project.thumbnail_alt class="card-img-top" sizes="(min-width: 768px) 520px, 90vw" -%}
  </a>
  <div class="card-body">
    <p class="project-card__status">{{ project.card_label }}</p>
    <h3 class="card-title">
      <a href="{{ project_url }}">{{ project.title }}</a>
    </h3>
    <p class="card-text">{{ project.card_description }}</p>
    <a href="{{ project_url }}">View case study →</a>
    {%- if project.github -%}
      <a class="project-github" href="{{ project.github }}">View source files</a>
    {%- endif %}
  </div>
</div>
