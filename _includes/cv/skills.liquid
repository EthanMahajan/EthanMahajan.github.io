{% comment %}
  Unified skills entry renderer for both formats
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="skill-item">
      {% assign skill_name = entry.name | default: entry.label %}
      <strong>
        {{- skill_name -}}
        {%- if entry.level %} ({{ entry.level }}){% endif %}:</strong
      >
      {% if entry.keywords %}
        {% for keyword in entry.keywords %}
          {% if forloop.last %}
            {{ keyword }}
          {% else %}
            {{ keyword }},
          {% endif %}
        {% endfor %}
      {% elsif entry.details %}
        {{ entry.details }}
      {% endif %}
      {% assign evidence_group = site.data.skill_evidence | where: 'skill', skill_name | first %}
      {% if evidence_group %}
        <ul class="skill-evidence" aria-label="Projects demonstrating {{ skill_name | escape }}">
          {% for evidence in evidence_group.examples %}
            <li>
              <a href="{{ evidence.url | relative_url }}">{{ evidence.label }}</a><span>{{ evidence.context }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</div>
