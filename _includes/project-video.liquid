<div
  class="project-video-lead"
  data-video="{{ include.project.hero.video }}"
  data-video-title="{{ include.project.title | escape }}: working prototype"
>
  <div class="video-poster">
    {% include figure.liquid path=include.project.hero.image alt=include.project.hero.alt class="video-poster__image" loading="eager" sizes="(min-width: 768px) 600px, 90vw" -%}
    <button type="button" class="btn btn-primary" data-video-load hidden>Play build video</button>
  </div>
  <p class="caption">{{ include.project.hero.video_caption }}</p>
  <a href="https://www.youtube.com/watch?v={{ include.project.hero.video }}">Watch on YouTube ↗</a>
</div>
