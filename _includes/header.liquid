<header class="site-header">
  <nav id="navbar" class="navbar navbar-light fixed-top" aria-label="Main navigation">
    <div class="container">
      <a class="navbar-brand" href="{{ '/' | relative_url }}">
        {{- site.first_name }}
        {{ site.last_name -}}
      </a>
      <button class="navbar-toggler" type="button" data-menu-toggle aria-controls="navbarNav" aria-expanded="false" hidden>Menu</button>
      <div id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}
                aria-current="page"
              {% endif %}
              >About</a
            >
          </li>
          {% assign navigation_pages = site.pages | sort: 'nav_order' %}
          {% for p in navigation_pages -%}
            {%- if p.nav %}
              <li class="nav-item">
                <a
                  class="nav-link{% if p.permalink == '/resume/' %} nav-resume{% endif %}"
                  href="{{ p.url | relative_url }}"
                  {% if page.url contains p.permalink %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- p.title -}}
                </a>
              </li>
            {% endif -%}
          {%- endfor %}
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" title="Theme: system. Switch to light" aria-label="Theme: system. Switch to light">
                <i class="fa-half-sun-moon" id="light-toggle-system" aria-hidden="true"></i
                ><i class="fa-solid fa-moon" id="light-toggle-dark" aria-hidden="true"></i
                ><i class="fa-solid fa-sun" id="light-toggle-light" aria-hidden="true"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
