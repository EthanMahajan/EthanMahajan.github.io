{% assign model_file = site.static_files | where: 'path', page.cad_model | first %}
{% assign preview_file = site.static_files | where: 'path', page.cad_preview | first %}
<section class="cad-viewer" data-cad-viewer data-model-url="{{ page.cad_preview | relative_url }}" aria-labelledby="cad-viewer-title">
  <h3 id="cad-viewer-title">Explore the Artorius assembly</h3>
  <div class="cad-static" data-cad-static>
    {% include figure.liquid path="assets/img/artoriusRevised.png" alt="Static CAD assembly showing the revised frame and electronics enclosure" caption="Revised CAD assembly. This static view remains available without WebGL." original_link=true %}
  </div>
  {% if preview_file %}
    <p class="cad-viewer__instructions">Drag to orbit, right-drag to pan, and scroll or pinch to zoom.</p>
    <button type="button" class="btn btn-outline-primary" data-cad-load>Load 3D model</button>
    <p data-cad-status role="status" aria-live="polite">The model loads on request.</p>
    <div data-cad-interface hidden>
      <div class="cad-viewer__canvas" data-cad-canvas></div>
      <div class="cad-viewer__toolbar">
        <button type="button" class="btn btn-outline-primary" data-cad-reset>Reset view</button>
        <button type="button" class="btn btn-outline-primary" data-cad-zoom-in aria-label="Zoom in">+</button>
        <button type="button" class="btn btn-outline-primary" data-cad-zoom-out aria-label="Zoom out">−</button>
      </div>
    </div>
    <noscript><p>Enable JavaScript to use the interactive model. You can still download the assembly.</p></noscript>
  {% else %}
    <p>The interactive preview is currently unavailable. The CAD images and printing video remain available on this page.</p>
  {% endif %}
  {% if model_file -%}
    <a href="{{ page.cad_model | relative_url }}" download>Download assembly meshes (.3mf, 54.9 MB)</a>
  {%- endif %}
</section>
