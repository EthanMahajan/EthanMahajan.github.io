<aside class="project-contact" aria-labelledby="project-contact-heading">
  <div>
    <h2 id="project-contact-heading">Discuss this project</h2>
  </div>
  <div class="portfolio-actions">
    {% capture contact_subject %}{{ page.title }}: portfolio inquiry{% endcapture %}
    <a class="btn btn-primary" href="mailto:{{ site.data.socials.email }}?subject={{ contact_subject | uri_escape }}">Email Ethan</a>
    <a class="btn btn-outline-primary" href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">Connect on LinkedIn</a>
  </div>
</aside>
