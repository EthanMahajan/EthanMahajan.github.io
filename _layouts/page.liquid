---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.collection == 'projects' and page.documentation_updated %}
      <p class="project-metadata">
        {%- if page.project_started %}Started {{ page.project_started }}. {% endif %}Documentation updated {{ page.documentation_updated | date: '%B %-d, %Y' }}
      </p>
    {% endif %}
  </header>

  <article>
    {% if page.collection == 'projects' %}
      {% include project-overview.liquid %}
      {% include project-hero.liquid %}
    {% endif %}
    {{ content }}
    {% if page.collection == 'projects' %}
      {% include project-notes.liquid %}
      {% include project-contact.liquid %}
    {% endif %}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}
</div>
