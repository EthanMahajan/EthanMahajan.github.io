---
layout: default
---
<div class="post home">
  <section class="home-intro" aria-labelledby="home-title">
    <div>
      <h1 id="home-title" class="post-title">
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <div id="about-copy">{{ content }}</div>
    </div>
    {% assign portrait = page.profile.image | prepend: 'assets/img/' %}
    {% include figure.liquid path=portrait alt=page.profile.image_alt class="home-portrait" loading="eager" sizes="220px" %}
  </section>
  {% assign artorius = site.projects | where: 'importance', 1 | first %}
  {% include featured-project.liquid project=artorius video=true %}
  <section aria-labelledby="more-work">
    <h2 id="more-work">More engineering work</h2>
    <div class="evidence-grid">
      {% assign project = site.projects | where: 'importance', 2 | first -%}
      {%- include projects.liquid %}
      <div class="project-card">
        <a class="project-card__image" href="{{ '/publications/' | relative_url }}">
          {%- include figure.liquid path="assets/img/publication_preview/IMG_2407.jpg" alt="Microscope field from the printed-cup study" class="card-img-top" sizes="(min-width: 768px) 520px, 90vw" -%}
        </a>
        <div class="card-body">
          <p class="project-card__status">Exploratory study · 2025</p>
          <h3><a href="{{ '/publications/' | relative_url }}">Particles in printed cups</a></h3>
          <p>Independent microscopy study of water held in FDM-printed cups, with explicit limits on particle identification.</p>
          <a href="{{ '/publications/' | relative_url }}">Read research summary →</a>
        </div>
      </div>
    </div>
  </section>
  <section class="contact-block" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact</h2>
    <p>
      <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
    </p>
    <nav class="portfolio-secondary-links" aria-label="Contact resources">
      <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a
      ><a href="{{ site.data.socials.cv_pdf | relative_url }}">Resume (PDF)</a>
    </nav>
  </section>
</div>
