---
layout: default
---
{% assign cv = site.data.cv.cv %}
<div class="post">
  <header class="post-header cv-header">
    <h1 class="post-title">Resume</h1>
    <a class="btn btn-outline-primary" href="{{ page.cv_pdf | relative_url }}">Resume (PDF)</a>
  </header>
  <div class="resume-intro">
    <p>
      <strong>{{ cv.name }}</strong> · {{ cv.headline -}}
      <br>
      {{ cv.location }} · <a href="mailto:{{ cv.email }}">{{ cv.email }}</a>
    </p>
    <span id="contact-information"></span><span id="professional-summary"></span>
    <p>{{ cv.sections['Professional Summary'][0].bullet }}</p>
  </div>
  <nav class="article-contents" aria-label="Resume sections">
    <p class="eyebrow">On this page</p>
    <ul>
      <li><a href="#education">Education</a></li>
      <li><a href="#experience">Engineering experience</a></li>
      <li><a href="#projects">Selected projects</a></li>
      <li><a href="#skills">Technical skills</a></li>
      <li><a href="#additional-experience">Additional experience</a></li>
      <li><a href="#involvement">Involvement</a></li>
    </ul>
  </nav>
  <article class="cv">
    <section class="cv-section" id="education">
      <h2>Education</h2>
      {% assign entries = cv.sections.Education | slice: 0, 2 -%}
      {%- include cv/education.liquid %}
      <details>
        <summary>Earlier education</summary>
        {% assign entries = cv.sections.Education | slice: 2, 10 -%}
        {%- include cv/education.liquid %}
      </details>
    </section>
    <section class="cv-section" id="experience">
      <h2>Engineering experience</h2>
      {% assign entries = cv.sections.Experience | slice: 0, 2 | sort: 'end_date' | reverse -%}
      {%- include cv/experience.liquid %}
    </section>
    <section class="cv-section" id="projects">
      <h2>Selected projects</h2>
      {% assign entries = cv.sections.Projects | sort: 'start_date' | reverse -%}
      {%- include cv/projects.liquid %}
    </section>
    <section class="cv-section" id="skills">
      <h2>Technical skills</h2>
      {% assign entries = cv.sections.Skills -%}
      {%- include cv/skills.liquid %}
    </section>
    <section class="cv-section" id="additional-experience">
      <h2>Additional experience</h2>
      {% assign entries = cv.sections.Experience | slice: 2, 20 | sort: 'end_date' | reverse -%}
      {%- include cv/experience.liquid %}
    </section>
    <section class="cv-section" id="involvement">
      <h2>Selected involvement</h2>
      {% assign entries = cv.sections.Involvement | sort: 'start_date' | reverse -%}
      {%- include cv/experience.liquid %}
    </section>
    <section class="cv-section cv-personal" aria-label="Interests and languages">
      <h2 id="interests">Interests</h2>
      {% assign entries = cv.sections.Interests -%}
      {%- include cv/interests.liquid %}
      <h2 id="languages">Languages</h2>
      {% assign entries = cv.sections.Languages -%}
      {%- include cv/languages.liquid %}
    </section>
  </article>
</div>
